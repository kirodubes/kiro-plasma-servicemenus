[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/allfiles;
Actions=sha1;sha256;md5
X-KDE-StartupNotify=false
X-KDE-Submenu=Checksum
X-KDE-Submenu[de]=Prüfsumme
X-KDE-Submenu[es]=Suma de verificación
X-KDE-Submenu[fr]=Somme de contrôle
X-KDE-Submenu[hu]=Ellenőrzőösszeg
X-KDE-Submenu[it]=Somma di controllo
X-KDE-Submenu[ja]=チェックサム
X-KDE-Submenu[nl]=Controlesom
X-KDE-Submenu[pl]=Suma kontrolna
X-KDE-Submenu[pt_BR]=Soma de verificação
X-KDE-Submenu[ro]=Sumă de control
X-KDE-Submenu[ru]=Контрольная сумма
X-KDE-Submenu[tr]=Sağlama toplamı
X-KDE-Submenu[zh_CN]=校验和

[Desktop Action sha1]
Name=Check sha1sum
Name[de]=sha1sum prüfen
Name[es]=Comprobar sha1sum
Name[fr]=Vérifier sha1sum
Name[hu]=sha1sum ellenőrzése
Name[it]=Verifica sha1sum
Name[ja]=sha1sum を確認
Name[nl]=sha1sum controleren
Name[pl]=Sprawdź sha1sum
Name[pt_BR]=Verificar sha1sum
Name[ro]=Verifică sha1sum
Name[ru]=Проверить sha1sum
Name[tr]=sha1sum kontrol et
Name[zh_CN]=检查 sha1sum
Icon=application-x-checksum
Exec=bash -c 'kdialog --title "sha1: $(basename "$1")" --msgbox "$(sha1sum "$1")"' _ %f

[Desktop Action sha256]
Name=Check sha256sum
Name[de]=sha256sum prüfen
Name[es]=Comprobar sha256sum
Name[fr]=Vérifier sha256sum
Name[hu]=sha256sum ellenőrzése
Name[it]=Verifica sha256sum
Name[ja]=sha256sum を確認
Name[nl]=sha256sum controleren
Name[pl]=Sprawdź sha256sum
Name[pt_BR]=Verificar sha256sum
Name[ro]=Verifică sha256sum
Name[ru]=Проверить sha256sum
Name[tr]=sha256sum kontrol et
Name[zh_CN]=检查 sha256sum
Icon=application-x-checksum
Exec=bash -c 'kdialog --title "sha256: $(basename "$1")" --msgbox "$(sha256sum "$1")"' _ %f

[Desktop Action md5]
Name=Check md5sum
Name[de]=md5sum prüfen
Name[es]=Comprobar md5sum
Name[fr]=Vérifier md5sum
Name[hu]=md5sum ellenőrzése
Name[it]=Verifica md5sum
Name[ja]=md5sum を確認
Name[nl]=md5sum controleren
Name[pl]=Sprawdź md5sum
Name[pt_BR]=Verificar md5sum
Name[ro]=Verifică md5sum
Name[ru]=Проверить md5sum
Name[tr]=md5sum kontrol et
Name[zh_CN]=检查 md5sum
Icon=application-x-checksum
Exec=bash -c 'kdialog --title "md5: $(basename "$1")" --msgbox "$(md5sum "$1")"' _ %f
